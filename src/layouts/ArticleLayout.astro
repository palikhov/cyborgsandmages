---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { SITE_POST_CATEGORIES } from "src/consts";
import ArticleMetadata from "~components/ArticleMetadata.astro";
import Breadcrumbs from "~components/Breadcrumbs.astro";
import FormattedDate from "~components/FormattedDate.astro";
import Share from "~components/Share.astro";
import BaseLayout from "~layouts/BaseLayout.astro";

type Props = CollectionEntry<"posts"> & {
	headings?: { depth: number; slug: string; text: string }[];
};

const { data, headings, slug, id } = Astro.props;

const { title, description, date, updatedAt, cover, author, authorUrl, translator, sourceUrl, tags, links } = data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const category = SITE_POST_CATEGORIES.find((entry) => entry.path === id.split("/")[0]);
const breadcrumbs = [
	{ name: "Главная", url: new URL("/", Astro.site).href },
	...(category ? [{ name: category.title, url: new URL(`/${category.path}/1`, Astro.site).href }] : []),
	{ name: title, url: canonicalURL }
];
---

<BaseLayout
	{title}
	{description}
	{headings}
	{links}>
	<ArticleMetadata
		{data}
		url={canonicalURL}
	/>
	<article class="prose my-8 w-full max-w-4xl px-2 font-serif sm:prose-lg lg:prose-xl sm:px-0">
		<Breadcrumbs items={breadcrumbs} />
		{
			cover && (
				<Image
					width={1024}
					format={"webp"}
					src={cover}
					alt={title}
					class="aspect-video h-auto w-full rounded-md object-cover object-center"
				/>
			)
		}
		<h1>{title}</h1>
		<div class="mb-8 mt-4 flex flex-col font-sans">
			<div><span class="font-semibold">Автор: {authorUrl ? <a href={authorUrl}>{author}</a> : author}</span></div>
			{
				translator && (
					<div>
						<span>Перевод: {translator}</span>
					</div>
				)
			}
			<div><FormattedDate date={date} /></div>
			{
				updatedAt && (
					<div>
						Обновлено: <FormattedDate date={updatedAt} />
					</div>
				)
			}
			{
				sourceUrl && (
					<div>
						<a href={sourceUrl}>Источник статьи</a>
					</div>
				)
			}

			<div class="not-prose flex flex-wrap">
				{
					tags.sort().flatMap((tag) => (
						<a
							href={`/tags/${tag}`}
							class="tag">
							{tag}
						</a>
					))
				}
			</div>
		</div>

		<div>
			<!-- <p class="lead pb-4">{description}</p> -->

			<slot />
			<hr />
			<p>
				Если вам понравилась эта статья или у вас есть комментарии, присоединяйтесь к дискуссии <a
					href="https://t.me/cyborgs_and_mages"
					target="_blank"
					>в канале Telegram</a
				> или <a
					href="https://discord.gg/yrJqvCqU3w"
					target="_blank"
					>сервере в Discord</a
				>.
			</p>

			<Share
				{title}
				{description}
				{slug}
				{tags}
			/>
		</div>
	</article>
</BaseLayout>
