---
import BaseLayout from "~layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import tagRegistry from "../../../tag-system.md?raw";

const allPosts = await getCollection("posts");
const now = new Date();
const counts = new Map<string, number>();
for (const { data } of allPosts) {
	if (data.draft || !(data.date <= now)) continue;
	for (const tag of new Set(data.tags)) {
		counts.set(tag, (counts.get(tag) ?? 0) + 1);
	}
}

const sections = [...tagRegistry.matchAll(/^### (.+)\r?\n([\s\S]*?)(?=^#{1,3} |(?![\s\S]))/gm)];
const authorSection = sections.find(([, heading]) => heading === "Авторские теги переводов");
const registeredAuthors = new Set(
	[...(authorSection?.[2] ?? "").matchAll(/^- `([^`]+)`/gm)].map(([, tag]) => tag)
);
const authorMappings = sections.find(([, heading]) => heading === "Соответствие авторов переводов тегам");
const registeredAuthorNames = new Set(
	[...(authorMappings?.[2] ?? "").matchAll(/^\| `([^`]+)` \| `[^`]+` \|/gm)].map(([, author]) => author)
);
const authorNames = new Set(allPosts.map((post) => post.data.author));
const alphabetical = (a: string, b: string) => a.localeCompare(b, "ru");
const groups = sections.map(([, heading, contents]) => ({
	heading,
	tags: [...contents.matchAll(/^\d+\. `([^`]+)`/gm)]
		.map(([, tag]) => tag)
		.filter((tag) => counts.has(tag))
		.sort(alphabetical)
})).filter(({ tags }) => tags.length > 0);
const groupedTags = new Set(groups.flatMap(({ tags }) => tags));
const remainingTags = [...counts.keys()].filter((tag) => !groupedTags.has(tag)).sort(alphabetical);
const isAuthor = (tag: string) =>
	registeredAuthors.has(tag) || registeredAuthorNames.has(tag) || authorNames.has(tag);
groups.push(
	{ heading: "Другие смысловые теги", tags: remainingTags.filter((tag) => !isAuthor(tag)) },
	{ heading: "Авторские теги", tags: remainingTags.filter(isAuthor) }
);

const title = "Тэги";
const description = "Список тэгов";
---

<BaseLayout
	{title}
	{description}
	sidebar={false}>
	<div class="mx-auto my-8 w-full max-w-4xl px-2">
		<div class="prose mx-auto text-center font-serif md:prose-lg sm:px-0">
			<h1>{description}</h1>
		</div>
	</div>

	<div class="mx-auto max-w-5xl space-y-10 px-2 pb-8">
		{groups.filter(({ tags }) => tags.length > 0).map(({ heading, tags }) => (
			<section>
				<h2 class="mb-4 font-serif text-2xl font-semibold">{heading}</h2>
				<ul class="flex flex-wrap gap-2">
					{tags.map((tag) => (
						<li>
							<a
								href={`/tags/${encodeURIComponent(tag)}`}
								class="inline-flex items-baseline gap-2 rounded border border-brand-crimson px-2 py-0.5 hover:bg-brand-crimson hover:text-white">
								{tag}
								<span class="text-xs tabular-nums">{counts.get(tag)}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</BaseLayout>
