---
import { type CollectionEntry, getCollection } from "astro:content";
import ArticleLayout from "~layouts/ArticleLayout.astro";
import Aside from "~components/Aside.astro";
import Verse from "~components/Verse.astro";
import Generator from "~components/Generator.astro";
import Creature from "~components/5e/Creature.astro";
import Item from "~components/5e/Item.astro";
import Link from "~components/Link.astro";
import File from "~components/File.astro";
import Youtube from "~components/Youtube.astro";
import AIQA from "~components/AIQA.svelte";

type Post = CollectionEntry<"posts">;

const formatTags = new Set(["перевод", "переклад"]);

function getTopicTags(post: Post) {
	return new Set(
		post.data.tags
			.map((tag) => tag.trim().toLowerCase())
			.filter((tag) => tag && !formatTags.has(tag))
	);
}

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	const now = new Date();
	const postsByTag = new Map<string, Post[]>();

	for (const post of posts) {
		if (post.data.draft || !(post.data.date <= now)) continue;

		for (const tag of getTopicTags(post)) {
			const matches = postsByTag.get(tag);
			if (matches) matches.push(post);
			else postsByTag.set(tag, [post]);
		}
	}

	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post, relatedPosts: getRelatedPosts(post, postsByTag) }
	}));
}

function getRelatedPosts(post: Post, postsByTag: Map<string, Post[]>) {
	const scores = new Map<Post, number>();

	for (const tag of getTopicTags(post)) {
		const matches = postsByTag.get(tag);
		if (!matches) continue;

		// Give more weight to specific topics with fewer published articles.
		const weight = 1 / Math.sqrt(matches.length);
		for (const candidate of matches) {
			if (candidate.slug === post.slug) continue;
			scores.set(candidate, (scores.get(candidate) ?? 0) + weight);
		}
	}

	return [...scores]
		.sort(([a, scoreA], [b, scoreB]) =>
			scoreB - scoreA || b.data.date.getTime() - a.data.date.getTime() || a.slug.localeCompare(b.slug)
		)
		.slice(0, 3)
		.map(([{ slug, data }]) => ({ slug, title: data.title }));
}

interface Props {
	post: Post;
	relatedPosts: ReturnType<typeof getRelatedPosts>;
}

const { post, relatedPosts } = Astro.props;

const { Content, headings } = await post.render();
---

<ArticleLayout
	{...post}
	{headings}>
	<AIQA
		article={post}
		client:visible
	/>

	<Content
		components={{
			Aside: Aside,
			Verse: Verse,
			Link: Link,
			File: File,
			Youtube: Youtube,
			Creature: Creature,
			Item: Item,
			Generator: Generator
		}}
	/>

	{
		relatedPosts.length > 0 && (
			<section aria-labelledby="related-posts-heading" class="mt-8 border-t border-brand-mist">
				<h2 id="related-posts-heading">Похожие статьи</h2>
				<ul>
					{relatedPosts.map(({ slug, title }) => (
						<li><a href={`/posts/${slug}`}>{title}</a></li>
					))}
				</ul>
			</section>
		)
	}
</ArticleLayout>
