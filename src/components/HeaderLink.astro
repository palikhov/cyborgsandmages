---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href } = Astro.props;

const { pathname } = Astro.url;

let isActive = false;

if (href != null) {
	const link = href.toString();
	isActive =
		link.length > 0 &&
		(pathname.startsWith("/posts" + link) || pathname.startsWith(link));
}

if (href === "/" && pathname !== "/") {
	isActive = false;
}
---

<a
	href={href}
	class:list={["font-medium hover:text-brand-crimson", { "text-brand-crimson": isActive }]}>
	<slot />
</a>
